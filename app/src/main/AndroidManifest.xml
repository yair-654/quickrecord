<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============================================================
         PERMISSIONS
         Exactly six. Note the deliberate ABSENCE of INTERNET.
         With no INTERNET permission the OS kernel refuses to create
         any socket for this app, so exfiltration is impossible even
         if malicious code existed in the APK.
         ============================================================ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app is meaningless without a camera, so declare it required. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickRecord">

        <!-- ========================================================
             COMPONENT 1: MainActivity
             Ordinary launcher entry. Used only for the first-run
             permission grants and the status/error screen.
             ======================================================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ========================================================
             COMPONENT 2: RecordActivity
             The lock-screen bridge. showWhenLocked + turnScreenOn are
             what let this draw on top of the keyguard WITHOUT the user
             authenticating, the same mechanism alarm clocks use.
             Transparent theme so nothing meaningful is displayed.
             exported=false: only our own tile can launch it.
             ======================================================== -->
        <activity
            android:name=".RecordActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.QuickRecord.Transparent"
            android:turnScreenOn="true" />

        <!-- ========================================================
             COMPONENT 3: RecordService
             Foreground service that owns the camera and recorder.
             foregroundServiceType camera|microphone is mandatory on
             Android 14+ or startForeground() throws
             MissingForegroundServiceTypeException.
             ======================================================== -->
        <service
            android:name=".RecordService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- ========================================================
             COMPONENT 4: QRTileService
             The Quick Settings tile. BIND_QUICK_SETTINGS_TILE ensures
             only the system's SystemUI process can bind to it, so no
             other app can drive your recorder.
             ======================================================== -->
        <service
            android:name=".QRTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
